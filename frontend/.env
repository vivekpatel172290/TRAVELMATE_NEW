# Google OAuth 2.0 Client ID (Google Identity Services for Real Google Sign-In)
# Obtain from: https://console.cloud.google.com -> APIs & Services -> Credentials -> Create OAuth client ID (Web Application)
# Authorized JavaScript Origin: http://localhost:5173 (and your production domain)
VITE_GOOGLE_CLIENT_ID=

# Google Maps Platform API Key (Vite Frontend)
# You can use either VITE_GOOGLE_MAPS_API_KEY or GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_API_KEY=AIzaSyCwcGlDVmlVmordXPjKBRJiPrKqIoQbeeY
GOOGLE_MAPS_API_KEY=AIzaSyCwcGlDVmlVmordXPjKBRJiPrKqIoQbeeY

# ==============================================================================
# FEATURE 1: DIGITAL INDIA BHASHINI MULTILINGUAL TRANSLATION INITIATIVE
# Obtain credentials from: https://bhashini.gov.in/ulca or https://dhruva.bhashini.gov.in
# When empty, TravelMate uses the high-fidelity offline Bhashini-ready engine.
# ==============================================================================
VITE_BHASHINI_USER_ID=
VITE_BHASHINI_API_KEY=
VITE_BHASHINI_INFERENCE_API_KEY=
VITE_BHASHINI_PIPELINE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ==============================================================================
# FEATURE 2: TRIP PLANNER REAL-TIME NEWS & DISRUPTIONS API
# Obtain from: https://newsapi.org or preferred news aggregator
# When empty, TravelMate uses verified local Delhi safety dispatches & ASI closures.
# ==============================================================================
VITE_NEWS_API_KEY=
VITE_NEWS_API_URL=https://newsapi.org/v2/everything
