# ==============================================================================
# TravelMate Frontend Environment Variables
# ==============================================================================

# Backend REST API base URL (Deployed Render Web Service)
# Format: https://<service-name>.onrender.com (without trailing slash)
# Leave empty during local dev to use Vite's local /api proxy
VITE_API_URL=https://travelmate-backend.onrender.com

# AI Microservice base URL (Deployed Render Web Service)
# Format: https://<service-name>.onrender.com (without trailing slash)
# Leave empty during local dev to use Vite's local /ai proxy
VITE_AI_URL=https://travelmate-ai-service.onrender.com

# Google OAuth 2.0 Client ID (for Real Google Sign-In)
# Obtain from: Google Cloud Console (console.cloud.google.com) -> APIs & Services -> Credentials -> Create OAuth client ID
# Authorized JavaScript Origin: http://localhost:5173 (local) and https://your-travelmate.vercel.app (production)
VITE_GOOGLE_CLIENT_ID=

# Google Maps Platform API Key (Optional for client-side Maps features)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...

# ==============================================================================
# FEATURE 1: DIGITAL INDIA BHASHINI MULTILINGUAL TRANSLATION INITIATIVE
# Obtain credentials from: https://bhashini.gov.in/ulca or https://dhruva.bhashini.gov.in
# When left empty, TravelMate runs with the built-in offline Bhashini-ready engine.
# ==============================================================================
VITE_BHASHINI_USER_ID=
VITE_BHASHINI_API_KEY=
VITE_BHASHINI_INFERENCE_API_KEY=
VITE_BHASHINI_PIPELINE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ==============================================================================
# FEATURE 2: TRIP PLANNER REAL-TIME NEWS & DISRUPTIONS API
# Obtain from: https://newsapi.org or preferred news aggregator
# When left empty, TravelMate uses verified local Delhi safety dispatches & ASI closure schedules.
# ==============================================================================
VITE_NEWS_API_KEY=
VITE_NEWS_API_URL=https://newsapi.org/v2/everything
